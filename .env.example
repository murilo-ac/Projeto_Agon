# Copie para .env e ajuste. Nunca versione o .env.
POSTGRES_USER=agon
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agon
POSTGRES_PORT=5432

# URL usada por api e worker dentro do Docker (host = nome do serviço)
DATABASE_URL=postgresql+psycopg://agon:troque-esta-senha@db:5432/agon

API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Coleta (valores padrão; descomente para alterar)
# ESPN_LEAGUES=soccer/bra.1,soccer/uefa.champions
# WORKER_TIMEZONE=America/Sao_Paulo
# CALENDAR_HOUR=5
# CALENDAR_DAYS_BACK=1
# CALENDAR_DAYS_AHEAD=7
# POSTGAME_INTERVAL_MINUTES=20
# POSTGAME_MIN_AGE_MINUTES=120
# POSTGAME_LOOKBACK_DAYS=7

# Chaves de provedores (vazio na v1: ESPN não exige chave)
API_SPORTS_KEY=
