# Copie para .env e ajuste. Nunca versione o .env.
POSTGRES_USER=agon
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agon
POSTGRES_PORT=5432

# URL usada por api e worker dentro do Docker (host = nome do serviço)
DATABASE_URL=postgresql+psycopg://agon:troque-esta-senha@db:5432/agon

API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Chaves de provedores (vazio na v1: ESPN não exige chave)
API_SPORTS_KEY=
